# MongoDB Connection URI (Prisma standard)
# Example MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/rpg_game?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/rpg_game?authSource=admin"

# App & Server Settings
PORT=3000
NODE_ENV=development

# JWT Secret for Master / Player Tokens
JWT_SECRET="rpg-epic-campaign-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# Frontend / Web URL (for invite links generation & CORS)
FRONTEND_URL="http://localhost:5173"
# Comma-separated allowed CORS origins (or '*' to allow all)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# AI Lore Enhancer (OpenAI / Gemini / Mock fallback)
# If OPENAI_API_KEY or GEMINI_API_KEY is not set, a smart local RPG narrative engine is used automatically.
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL="gpt-4o-mini"
IMAGE_MODEL="dall-e-3"
